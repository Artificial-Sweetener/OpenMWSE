sampler_3d openmwseCloudNoiseTexture {
    source = "textures/openmwse/atmosphere_cloud_noise.dds";
    min_filter = linear_mipmap_linear;
    mag_filter = linear;
    wrap_s = repeat;
    wrap_t = repeat;
    wrap_r = repeat;
}

sampler_3d openmwseCloudDetailNoiseTexture {
    source = "textures/openmwse/atmosphere_cloud_detail.dds";
    min_filter = linear_mipmap_linear;
    mag_filter = linear;
    wrap_s = repeat;
    wrap_t = repeat;
    wrap_r = repeat;
}

sampler_2d openmwseCloudCurlNoiseTexture {
    source = "textures/openmwse/atmosphere_cloud_curl.dds";
    min_filter = linear;
    mag_filter = linear;
    wrap_s = repeat;
    wrap_t = repeat;
}

sampler_2d openmwseCloudWeatherTexture {
    source = "textures/openmwse/atmosphere_cloud_weather.dds";
    min_filter = linear;
    mag_filter = linear;
    wrap_s = repeat;
    wrap_t = repeat;
}

shared {
    #include "lib/atmosphere/textured_clouds.glsl"
    #include "lib/atmosphere/solar.glsl"
    uniform sampler2D openmwseSunGlareTexture;

    /// Reconstruct a normalized world direction independently of the sampled scene depth.
    vec3 sunlightWorldDirection(vec2 uv)
    {
        vec4 view = omw.invProjectionMatrix * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
        return normalize((omw.invViewMatrix * vec4(normalize(view.xyz), 0.0)).xyz);
    }

    // World reconstruction and linear depth helpers abstract the active depth convention. Distances are world units;
    // lighting and pass outputs remain scene-linear HDR until the normal post-processing tonemap.
    /// Expose canonical cloud controls to the shared cloud implementation.
    vec4 openmwseCloudParameters()
    {
        return omw.atmosphereCloudParameters;
    }


    /// Expose incoming coverage and physical dimensions without replacing the outgoing field.
    vec4 openmwseIncomingCloudParameters() { return omw.atmosphereIncomingCloudParameters; }

    /// Expose stable field phases and the optical crossfade weight.
    vec4 openmwseCloudScenarioParameters() { return omw.atmosphereCloudScenarioParameters; }

    /// Expose the independently placeable low-cloud layer to the shared implementation.
    vec4 openmwseLowCloudParameters()
    {
        return omw.atmosphereLowCloudParameters;
    }

    /// Expose weather and environment morphology for the low-cloud layer.
    float openmwseLowCloudEnvironmentInfluence()
    {
        return omw.atmosphereLowCloudEnvironmentInfluence;
    }

    /// Expose local terrain height and terrain-following controls to shared cloud height calculations.
    vec4 openmwseCloudMediumReferenceParameters()
    {
        return omw.atmosphereMediumReferenceParameters;
    }

    /// Expose the sparse terrain sample center and gradient used by orographic formation.
    vec4 openmwseCloudOrographicParameters()
    {
        return omw.atmosphereOrographicParameters;
    }

    /// Read one packed world-terrain sample without depending on the observer's local plane.
    vec4 openmwseCloudTerrainHeights(int index) { return omw.atmosphereTerrainHeights[index]; }
    /// Locate the fixed lattice samples in world units.
    vec4 openmwseCloudTerrainOriginSpacing() { return omw.atmosphereTerrainOriginSpacing; }
    /// Enclose the cloud formation terrain field.
    vec2 openmwseCloudTerrainHeightBounds() { return omw.atmosphereTerrainHeightBounds; }

    /// Expose the exterior water datum to shared cloud height calculations.
    float openmwseCloudWaterHeight()
    {
        return omw.waterHeight;
    }

    /// Return the native post-process camera position used by spherical cloud geometry.
    vec3 openmwseCloudEyePosition()
    {
        return omw.eyePos.xyz;
    }

    /// Expose integrated world-space cloud displacement to deterministic cloud advection.
    vec2 openmwseCloudAdvectionOffsetWorldUnits()
    {
        return omw.atmosphereCloudAdvectionOffsetWorldUnits;
    }

    /// Sample the canonical tileable multi-channel cloud shape volume.
    vec4 openmwseCloudNoiseSample(vec3 coordinates, float lodBias)
    {
        return omw_Texture3DLod(openmwseCloudNoiseTexture, coordinates, lodBias);
    }

    /// Sample the independent high-frequency cloud erosion volume.
    vec4 openmwseCloudDetailNoiseSample(vec3 coordinates, float lodBias)
    {
        return omw_Texture3DLod(openmwseCloudDetailNoiseTexture, coordinates, lodBias);
    }

    /// Sample the encoded curl field for base-weighted detail distortion.
    vec3 openmwseCloudCurlNoiseSample(vec2 coordinates)
    {
        return omw_Texture2DLod(openmwseCloudCurlNoiseTexture, coordinates, 0.0).rgb;
    }

    /// Sample the canonical broad cloud-organization and morphology field.
    vec4 openmwseCloudWeatherSample(vec2 coordinates)
    {
        return omw_Texture2DLod(openmwseCloudWeatherTexture, coordinates, 0.0);
    }

    #include "lib/util/dither.glsl"
    #include "lib/atmosphere/aerial_perspective.glsl"
    /// Read one source cloud-layer parameter from the shared graphics publication.
    vec4 openmwseCloudModelParameter(int layer, int field)
    {
        return omw.atmosphereCloudLayers[layer * 14 + field];
    }

    #include "lib/atmosphere/cloud_model.glsl"
#include "lib/atmosphere/cloud_shadow_column.glsl"
    #include "lib/atmosphere/cloud_field.glsl"
    #include "lib/atmosphere/clouds.glsl"

    /// Assemble shared aerial-perspective parameters from native post-process uniforms.
    OpenMWSEAerialPerspectiveParameters aerialPerspectiveParameters()
    {
        OpenMWSEAerialPerspectiveParameters parameters;
        parameters.scatteringEnabled = omw.atmosphereScatteringEnabled;
        parameters.appearance = omw.atmosphereAppearance;
        parameters.inScattering = omw.atmosphereInScattering;
        parameters.outScattering = omw.atmosphereOutScattering;
        parameters.skyColor = omw.skyColor.rgb;
        parameters.fogColor = omw.fogColor.rgb;
        parameters.sunDirection = omw.sunPos.xyz;
        parameters.solarRadiance = omw.atmosphereSolarRadiance;
        parameters.skyIrradiance = omw.atmosphereSkyIrradiance;
        parameters.groundIrradiance = omw.atmosphereGroundIrradiance;
        parameters.weatherWeight = omw.atmosphereWeatherWeight;
        parameters.fogStart = omw.fogNear;
        parameters.fogEnd = omw.fogFar;
#if OMW_EXPONENTIAL_FOG
        parameters.exponentialFog = 1.0;
#else
        parameters.exponentialFog = 0.0;
#endif
        parameters.referenceHeight = omw.waterHeight;
        parameters.observerHeight = omw.eyePos.z;
        parameters.weatherCloudTopHeight = openmwseWeatherCloudTopHeight();
        parameters.weatherCloudCoverage = omw.atmosphereCloudParameters.x;
        return parameters;
    }

    /// Produce a deterministic scalar for a two-dimensional mist-noise lattice point.
    float atmosphereHash(vec2 position)
    {
        vec3 value = fract(vec3(position.xyx) * vec3(0.1031, 0.1030, 0.0973));
        value += dot(value, value.yzx + 33.33);
        return fract((value.x + value.y) * value.z);
    }

    /// Interpolate smooth deterministic noise across the mist-noise lattice.
    float atmosphereNoise(vec2 position)
    {
        vec2 cell = floor(position);
        vec2 offset = fract(position);
        vec2 blend = offset * offset * (3.0 - 2.0 * offset);
        float lower = mix(atmosphereHash(cell), atmosphereHash(cell + vec2(1.0, 0.0)), blend.x);
        float upper = mix(atmosphereHash(cell + vec2(0.0, 1.0)), atmosphereHash(cell + vec2(1.0)), blend.x);
        return mix(lower, upper, blend.y);
    }

    /// Return the forward ray interval intersecting a horizontal atmosphere layer.
    vec2 layerIntersection(vec3 origin, vec3 direction, float lowerHeight, float upperHeight)
    {
        if (abs(direction.z) < 0.0001)
            return origin.z >= lowerHeight && origin.z <= upperHeight ? vec2(0.0, omw.far) : vec2(1.0, 0.0);
        float first = (lowerHeight - origin.z) / direction.z;
        float second = (upperHeight - origin.z) / direction.z;
        return vec2(max(0.0, min(first, second)), min(omw.far, max(first, second)));
    }

    /// Use the observer-independent cloud terrain field for mist and fog placement.
    float atmosphereLocalGroundHeight(vec2 worldPosition)
    {
        return openmwseCloudFormationTerrain(worldPosition).x;
    }

    /// Evaluate height-fog density in the same integrated world-space advection field as clouds and shadows.
    float mistDensityAt(vec3 worldPosition)
    {
        float densityScale = max(omw.atmosphereMistParameters.x, 0.0);
        float baseHeight = atmosphereLocalGroundHeight(worldPosition.xy) + omw.atmosphereMistParameters.y;
        float thickness = max(omw.atmosphereMistParameters.z, 1.0);
        float height = (worldPosition.z - (baseHeight - thickness * 0.2)) / (thickness * 1.2);
        float heightShape = 1.0 - smoothstep(0.15, 1.0, height);
        vec2 advectedWorldPosition = worldPosition.xy + omw.atmosphereCloudAdvectionOffsetWorldUnits;
        vec2 noisePosition
            = advectedWorldPosition * 0.00011 + worldPosition.z * vec2(0.000025, -0.000018);
        float detail = atmosphereNoise(noisePosition) * 0.68
            + atmosphereNoise(noisePosition * 2.13 + vec2(9.7, -13.1)) * 0.32;
        float valleyPooling = smoothstep(300.0, 4200.0, omw.atmosphereMediumReferenceParameters.w)
            * openmwseCloudTerrainInfluence(worldPosition.xy);
        return densityScale * heightShape * smoothstep(0.18, 0.82, detail)
            * mix(1.0, 1.58, valleyPooling);
    }

    /// Evaluate sustained volumetric fog as a smoother ground-coupled medium than localized mist.
    float fogDensityAt(vec3 worldPosition)
    {
        float densityScale = max(omw.atmosphereFogVolumeParameters.x, 0.0);
        float baseHeight = atmosphereLocalGroundHeight(worldPosition.xy) + omw.atmosphereFogVolumeParameters.y;
        float thickness = max(omw.atmosphereFogVolumeParameters.z, 1.0);
        float relativeHeight = max((worldPosition.z - baseHeight) / thickness, 0.0);
        float heightShape = exp(-relativeHeight * 2.6)
            * (1.0 - smoothstep(0.78, 1.15, relativeHeight));
        vec2 advectedWorldPosition
            = worldPosition.xy + omw.atmosphereCloudAdvectionOffsetWorldUnits * 0.32;
        float broadVariation = atmosphereNoise(advectedWorldPosition * 0.000035 + vec2(7.1, -23.4));
        float valleyPooling = smoothstep(600.0, 5200.0, omw.atmosphereMediumReferenceParameters.w)
            * openmwseCloudTerrainInfluence(worldPosition.xy);
        return densityScale * heightShape * mix(0.78, 1.08, broadVariation)
            * mix(1.0, 1.16, valleyPooling);
    }

    /// Evaluate the mist's normalized forward-scattering phase function.
    float miePhase(float cosineAngle, float anisotropy)
    {
        float denominator = 1.0 + anisotropy * anisotropy - 2.0 * anisotropy * cosineAngle;
        return (1.0 - anisotropy * anisotropy) / max(12.5663706 * pow(denominator, 1.5), 0.001);
    }

    /// Project the world-space sun direction into post-process texture coordinates.
    vec2 projectedSun()
    {
        vec4 viewSun = omw.viewMatrix * vec4(openmwseApparentSunDirection(normalize(omw.sunPos.xyz)), 0.0);
        vec4 clipSun = omw_ProjectionMatrix() * viewSun;
        return clipSun.xy / max(clipSun.w, 0.0001) * 0.5 + 0.5;
    }

    /// Convert scene-linear RGB radiance to relative luminance.
    float luminance(vec3 color)
    {
        return dot(color, vec3(0.2126, 0.7152, 0.0722));
    }

    const float maximumAtmosphereHistoryAdvectionWorldUnits = 128.0;

    /// Reproject source clouds by camera motion and retain the native fog/mist wind model.
    float atmosphereMediumAdvectionScale(float mediumType)
    {
        if (mediumType >= 1.5)
            return 0.0;
        if (mediumType < 0.5)
            return 0.0;
        float mistWeight = max(omw.atmosphereMistParameters.x, 0.0);
        float fogWeight = max(omw.atmosphereFogVolumeParameters.x, 0.0);
        return (mistWeight + fogWeight * 0.32) / max(mistWeight + fogWeight, 0.0001);
    }

    /// Report whether global state permits checkerboard reprojection and local-medium accumulation.
    bool atmosphereTemporalSamplingEnabled()
    {
        if (!omw_AtmosphereHistoryValid || omw.atmosphereHistoryLightingWeight < 0.5
            || length(omw.atmosphereCloudAdvectionDeltaWorldUnits)
                > maximumAtmosphereHistoryAdvectionWorldUnits)
            return false;

        // CPU lighting compatibility covers weather, but the observer can cross the deck without a weather change.
        // Reuse the canonical recovery model so history cannot carry ground haze into the above-cloud atmosphere.
        OpenMWSEAerialPerspectiveParameters parameters = aerialPerspectiveParameters();
        float currentRecovery = openmwseClearAirRecovery(parameters);
        vec3 previousEye = -omw.prevViewMatrix[3].xyz * mat3(omw.prevViewMatrix);
        parameters.observerHeight = previousEye.z;
        return abs(currentRecovery - openmwseClearAirRecovery(parameters)) < 0.1;
    }

    /// Return scene termination in world units measured along the current camera ray.
    float atmosphereSceneRayDistance(vec2 uv)
    {
        return min(length(omw_GetWorldPosFromUV(uv) - omw.eyePos.xyz), omw.far);
    }

    /// Report whether the current depth sample is the exact far-plane clear value rather than distant geometry.
    bool atmosphereDepthIsClear(vec2 uv)
    {
        return omw_GetDepth(uv) >= 1.0;
    }

    /// Report whether the previous depth sample is the exact far-plane clear value rather than distant geometry.
    bool atmospherePreviousDepthIsClear(vec2 uv)
    {
        return omw_GetPreviousDepth(uv) >= 1.0;
    }

    /// Weight a volume sample across a silhouette only when its medium lies in front of both scene terminations.
    float atmosphereTerminationWeight(bool centerOpenSky, bool sampleOpenSky, float representativeDistance,
        float centerSceneDistance, float sampleSceneDistance, float depthTolerance, float terminationTolerance)
    {
        // Far-plane world positions lie on the camera frustum, not on an opaque surface. Their radial
        // distances vary with view direction and must never manufacture a clear-sky disocclusion.
        if (centerOpenSky && sampleOpenSky)
            return 1.0;
        bool sharedForegroundMedium
            = representativeDistance + depthTolerance < min(centerSceneDistance, sampleSceneDistance);
        if (sharedForegroundMedium)
            return 1.0;
        if (centerOpenSky != sampleOpenSky)
            return 0.0;
        float terminationDifference = abs(sampleSceneDistance - centerSceneDistance);
        return 1.0 - smoothstep(
            terminationTolerance, terminationTolerance * 4.0, terminationDifference);
    }

    /// Encode non-negative world-unit distance into half-float-safe metadata.
    float encodeAtmosphereDistance(float distance)
    {
        return log2(1.0 + max(distance, 0.0)) / 20.0;
    }

    /// Decode half-float-safe metadata into world-unit distance.
    float decodeAtmosphereDistance(float encodedDistance)
    {
        return exp2(encodedDistance * 20.0) - 1.0;
    }


    /// Accumulate bounded nearby point-light radiance for supported mist quality levels.
    vec3 atmospherePointLighting(vec3 worldPosition)
    {
        if (omw.atmosphereQuality < 2)
            return vec3(0.0);

        vec3 lighting = vec3(0.0);
        int lightCount = omw_GetPointLightCount();
        if (lightCount > 8)
            lightCount = 8;
        for (int lightIndex = 0; lightIndex < 8; ++lightIndex)
        {
            if (lightIndex >= lightCount)
                break;
            vec3 offset = omw_GetPointLightWorldPos(lightIndex) - worldPosition;
            float distanceToLight = length(offset);
            float radius = max(omw_GetPointLightRadius(lightIndex), 1.0);
            if (distanceToLight >= radius)
                continue;
            vec3 attenuation = omw_GetPointLightAttenuation(lightIndex);
            float inverseFalloff = 1.0 / max(attenuation.x + attenuation.y * distanceToLight
                + attenuation.z * distanceToLight * distanceToLight, 0.001);
            float edgeFade = 1.0 - smoothstep(radius * 0.82, radius, distanceToLight);
            lighting += omw_GetPointLightDiffuse(lightIndex) * inverseFalloff * edgeFade;
        }
        return lighting * 0.32;
    }
    /// Return the integer resolved dimensions used by the native ratio-sized targets.
    vec2 atmosphereVolumeDimensions()
    {
        return max(floor(omw.resolution * omw.atmosphereVolumeResolutionScale), vec2(1.0));
    }

    /// Return the complete 2x2 blocks traced this frame; odd edge pixels are integrated during resolve.
    vec2 atmosphereRawDimensions()
    {
        return max(floor(atmosphereVolumeDimensions() * 0.5), vec2(1.0));
    }

    /// Return the center of the nearest resolved-volume texel so radiance and categorical metadata stay paired.
    vec2 atmosphereHistoryTexelCenter(vec2 uv)
    {
        vec2 dimensions = atmosphereVolumeDimensions();
        vec2 coordinate = clamp(floor(uv * dimensions), vec2(0.0), dimensions - 1.0);
        return (coordinate + 0.5) / dimensions;
    }

    /// Visit every member of each 2x2 block once per four frames.
    vec2 atmosphereCheckerboardOffset(vec2 blockCoordinate)
    {
        float blockPhase = mod(blockCoordinate.x + blockCoordinate.y, 2.0);
        float phase = mod(float(omw.frameNumber) + blockPhase, 4.0);
        return vec2(mod(phase, 2.0), floor(phase * 0.5));
    }

    /// Integrate one camera ray with draw-constant lighting and altitude-dependent recovery, retaining its depth moment.
    vec4 integrateAtmosphereAtUv(vec2 uv, OpenMWSEVolumeIllumination lowCloudLighting,
        vec3 belowCloudDiffuse, out vec4 metadata)
    {
        float sceneDistance = atmosphereSceneRayDistance(uv);
        metadata = vec4(encodeAtmosphereDistance(omw.far), 0.0,
            encodeAtmosphereDistance(sceneDistance), 0.0);
        bool cloudsEnabled
            = omw.atmosphereCloudParameters.x > 0.001 || omw.atmosphereLowCloudParameters.x > 0.001;
        bool mistEnabled = omw.atmosphereMistParameters.x > 0.001;
        bool fogEnabled = omw.atmosphereFogVolumeParameters.x > 0.001;
        if (!omw.atmosphereEnabled || (!cloudsEnabled && !mistEnabled && !fogEnabled))
        {
            return vec4(0.0, 0.0, 0.0, 1.0);
        }

        vec3 worldPosition = omw_GetWorldPosFromUV(uv);
        vec3 rayDirection = normalize(worldPosition - omw.eyePos.xyz);
        bool openSky = atmosphereDepthIsClear(uv);
        float cloudMaximumDistance = openSky ? openmwseCloudMaximumRayDistance : sceneDistance;
        OpenMWSEAerialPerspectiveParameters atmosphere = aerialPerspectiveParameters();
        OpenMWSELocalMedia localMedia;
        localMedia.count = 0;
        localMedia.startDistance = 0.0;
        localMedia.stepLength = 1.0;
        if (mistEnabled || fogEnabled)
        {
            float mistThickness = max(omw.atmosphereMistParameters.z, 1.0);
            vec2 terrainBounds = max(openmwseCloudTerrainHeightBounds(), vec2(omw.waterHeight));
            vec2 mistBaseHeight = terrainBounds + omw.atmosphereMistParameters.y;
            float fogThickness = max(omw.atmosphereFogVolumeParameters.z, 1.0);
            vec2 fogBaseHeight = terrainBounds + omw.atmosphereFogVolumeParameters.y;
            float lowerHeight = mistEnabled ? mistBaseHeight.x - mistThickness * 0.2 : fogBaseHeight.x;
            float upperHeight = mistEnabled ? mistBaseHeight.y + mistThickness : fogBaseHeight.y + fogThickness * 1.15;
            if (fogEnabled)
            {
                lowerHeight = min(lowerHeight, fogBaseHeight.x);
                upperHeight = max(upperHeight, fogBaseHeight.y + fogThickness * 1.15);
            }
            vec2 interval = layerIntersection(omw.eyePos.xyz, rayDirection, lowerHeight, upperHeight);
            interval.y = min(interval.y, sceneDistance);
            if (interval.y > interval.x)
            {
                int sampleCount = 6 + omw.atmosphereQuality * 3;
                float stepLength = (interval.y - interval.x) / float(sampleCount);
                localMedia.count = sampleCount;
                localMedia.startDistance = interval.x;
                localMedia.stepLength = stepLength;
                vec3 sunDirection = normalize(omw.sunPos.xyz);
                float mistWeight = max(omw.atmosphereMistParameters.x, 0.0);
                float fogWeight = max(omw.atmosphereFogVolumeParameters.x, 0.0);
                float anisotropy = mix(omw.atmosphereFogVolumeParameters.w, 0.62,
                    mistWeight / max(mistWeight + fogWeight, 0.0001));
                float phase = miePhase(dot(rayDirection, sunDirection), anisotropy);
                OpenMWSECloudLayer mainCloud = openmwseMainCloudLayer();
                OpenMWSECloudLayer incomingCloud = openmwseIncomingCloudLayer();
                OpenMWSECloudLayer lowCloud = openmwseLowCloudLayer();

                float previousLightRecovery = 0.0;
                OpenMWSEVolumeIllumination illumination
                    = OpenMWSEVolumeIllumination(lowCloudLighting.solarIrradiance, belowCloudDiffuse);

                for (int sampleIndex = 0; sampleIndex < 15; ++sampleIndex)
                {
                    if (sampleIndex >= sampleCount)
                        break;
                    float segmentStart = interval.x + float(sampleIndex) * stepLength;
                    // Shallow media vary on a much broader scale than one segment. A stable midpoint
                    // is unbiased for the local linear field and avoids injecting needless temporal variance.
                    float distanceAlongRay = segmentStart + 0.5 * stepLength;
                    vec3 samplePosition = omw.eyePos.xyz + rayDirection * distanceAlongRay;
                    float mistDensity = mistEnabled ? mistDensityAt(samplePosition) : 0.0;
                    float fogDensity = fogEnabled ? fogDensityAt(samplePosition) : 0.0;
                    localMedia.segments[sampleIndex] = vec4(0.0);
                    float density = mistDensity + fogDensity;
                    if (density > 0.0001)
                    {
                        float extinction = mistDensity * 0.00042 + fogDensity * 0.00032;
                        vec3 localLight = atmospherePointLighting(samplePosition);
                        OpenMWSEAerialPerspectiveParameters sampleAtmosphere = atmosphere;
                        sampleAtmosphere.observerHeight = samplePosition.z;
                        float lightRecovery = openmwseClearAirRecovery(sampleAtmosphere);
                        // Height changes incident light only through clear-air recovery; its plateaus share one integral.
                        if (lightRecovery != previousLightRecovery)
                        {
                            illumination = openmwseLocalVolumeIllumination(omw.atmosphereSolarRadiance,
                                omw.atmosphereGroundIrradiance, samplePosition.z, atmosphere);
                            previousLightRecovery = lightRecovery;
                        }
                        float solarVisibility = openmwseLocalMediaSunTransmittance(
                            samplePosition, sunDirection, mainCloud, incomingCloud, lowCloud);
                        vec3 directLight = illumination.solarIrradiance * solarVisibility * phase;
                        localMedia.segments[sampleIndex]
                            = vec4(illumination.diffuseRadiance + directLight + localLight, extinction);
                    }
                }
            }
        }

        float visibleDistanceSum = 0.0;
        float visibleCloudOpacity = 0.0;
        vec4 integratedVolume = openmwseIntegrateClouds(omw.eyePos.xyz, rayDirection,
            cloudMaximumDistance, omw.atmosphereQuality, omw.atmosphereSolarRadiance,
            omw.atmosphereSkyIrradiance, omw.atmosphereGroundIrradiance, lowCloudLighting, atmosphere,
            localMedia, visibleDistanceSum, visibleCloudOpacity);
        float opacity = 1.0 - integratedVolume.a;
        if (opacity > 1e-5)
        {
            float representativeDistance = visibleDistanceSum / opacity;
            float mediumType = opacity - visibleCloudOpacity >= visibleCloudOpacity ? 1.0 : 2.0;
            metadata = vec4(encodeAtmosphereDistance(representativeDistance), opacity,
                encodeAtmosphereDistance(sceneDistance), mediumType);
        }
        return integratedVolume;
    }

}

render_target AtmosphereVolumeRaw {
    width_ratio = 0.25;
    height_ratio = 0.25;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
    mipmaps = false;
    min_filter = nearest;
    mag_filter = nearest;
    clear_color = vec4(0.0, 0.0, 0.0, 1.0);
}

render_target AtmosphereVolumeMetadataRaw {
    width_ratio = 0.25;
    height_ratio = 0.25;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
    mipmaps = false;
    min_filter = nearest;
    mag_filter = nearest;
    clear_color = vec4(1.0, 0.0, 1.0, 0.0);
}

render_target AtmosphereVolumeMetadataHistory {
    width_ratio = 0.5;
    height_ratio = 0.5;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
    mipmaps = false;
    min_filter = nearest;
    mag_filter = nearest;
    clear_color = vec4(1.0, 0.0, 1.0, 0.0);
}

render_target AtmosphereVolumeHistory {
    width_ratio = 0.5;
    height_ratio = 0.5;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
    mipmaps = false;
    min_filter = linear;
    mag_filter = linear;
    clear_color = vec4(0.0, 0.0, 0.0, 1.0);
}

render_target AtmosphereVolumeReprojected {
    width_ratio = 0.5;
    height_ratio = 0.5;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
    mipmaps = false;
    min_filter = nearest;
    mag_filter = nearest;
    clear_color = vec4(0.0, 0.0, 0.0, 1.0);
}

render_target AtmosphereVolumeMetadataReprojected {
    width_ratio = 0.5;
    height_ratio = 0.5;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
    mipmaps = false;
    min_filter = nearest;
    mag_filter = nearest;
    clear_color = vec4(1.0, 0.0, 1.0, 0.0);
}

render_target AtmosphereShaftMask {
    width_ratio = 0.5;
    height_ratio = 0.5;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
    mipmaps = false;
    min_filter = linear;
    mag_filter = linear;
    clear_color = vec4(0.0, 0.0, 0.0, 0.0);
}

render_target AtmosphereShaftSource {
    width_ratio = 0.5;
    height_ratio = 0.5;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
    mipmaps = false;
    min_filter = linear;
    mag_filter = linear;
    clear_color = vec4(0.0, 0.0, 0.0, 0.0);
}

render_target AtmosphereShaftRays {
    width_ratio = 1.0;
    height_ratio = 1.0;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
    mipmaps = false;
    min_filter = linear;
    mag_filter = linear;
    clear_color = vec4(0.0, 0.0, 0.0, 0.0);
}

render_target AtmosphereShafts {
    width_ratio = 1.0;
    height_ratio = 1.0;
    internal_format = rgba16f;
    source_type = half_float;
    source_format = rgba;
    mipmaps = false;
    min_filter = linear;
    mag_filter = linear;
    clear_color = vec4(0.0, 0.0, 0.0, 0.0);
}

vertex integrateAtmosphereVolume {
    #include "lib/atmosphere/volume_lighting_vertex.glsl"
}

fragment integrateAtmosphereVolume(target=AtmosphereVolumeRaw, secondary_target=AtmosphereVolumeMetadataRaw) {
    #pragma import_defines(OPENMWSE_CLOUD_STEADY)
    omw_In vec2 omw_TexCoord;
#if __VERSION__ >= 130 || defined(GL_EXT_gpu_shader4)
    flat
#endif
    omw_In vec3 atmosphereLowSolarIrradiance;
#if __VERSION__ >= 130 || defined(GL_EXT_gpu_shader4)
    flat
#endif
    omw_In vec3 atmosphereLowDiffuseRadiance;
#if __VERSION__ >= 130 || defined(GL_EXT_gpu_shader4)
    flat
#endif
    omw_In vec3 atmosphereBelowCloudDiffuse;


    void main()
    {
        vec2 blockCoordinate = floor(gl_FragCoord.xy);
        vec2 volumeCoordinate = blockCoordinate * 2.0 + atmosphereCheckerboardOffset(blockCoordinate);
        vec2 uv = (volumeCoordinate + 0.5) / atmosphereVolumeDimensions();
        vec4 metadata;
        omw_FragColor = integrateAtmosphereAtUv(
            uv,
            OpenMWSEVolumeIllumination(atmosphereLowSolarIrradiance, atmosphereLowDiffuseRadiance),
            atmosphereBelowCloudDiffuse, metadata);
        omw_FragColor1 = metadata;
    }
}


fragment reprojectAtmosphereVolume(
    target=AtmosphereVolumeReprojected, secondary_target=AtmosphereVolumeMetadataReprojected,
    rt1=AtmosphereVolumeRaw, rt2=AtmosphereVolumeMetadataRaw) {
    omw_In vec2 omw_TexCoord;

    /// Bound local mist and fog history with the current five-sample neighborhood.
    vec4 clipLocalMediaHistory(vec4 history, vec2 uv)
    {
        vec2 texel = 1.0 / atmosphereRawDimensions();
        vec2 minimumUv = texel * 0.5;
        vec2 maximumUv = vec2(1.0) - minimumUv;
        vec4 current = omw_Texture2D(AtmosphereVolumeRaw, uv);
        vec4 left = omw_Texture2D(AtmosphereVolumeRaw, clamp(uv - vec2(texel.x, 0.0), minimumUv, maximumUv));
        vec4 right = omw_Texture2D(AtmosphereVolumeRaw, clamp(uv + vec2(texel.x, 0.0), minimumUv, maximumUv));
        vec4 down = omw_Texture2D(AtmosphereVolumeRaw, clamp(uv - vec2(0.0, texel.y), minimumUv, maximumUv));
        vec4 up = omw_Texture2D(AtmosphereVolumeRaw, clamp(uv + vec2(0.0, texel.y), minimumUv, maximumUv));
        vec4 sum = current + left + right + down + up;
        vec4 squaredSum = current * current + left * left + right * right + down * down + up * up;
        vec4 mean = sum / 5.0;
        vec4 deviation = sqrt(max(squaredSum / 5.0 - mean * mean, vec4(0.0)));
        // A resolved current pixel can be a genuine spatial extremum, not temporal noise. Keep it in
        // the clipping box so repeated reconstruction cannot flatten an already stable medium edge.
        return clamp(history, min(mean - deviation, current), max(mean + deviation, current));
    }

    /// Filter cloud history across compatible opaque endpoints without mixing through a scene silhouette.
    vec4 sampleTerrainCloudHistory(vec2 uv, vec2 anchorUv, vec4 anchorMetadata)
    {
        vec2 dimensions = atmosphereVolumeDimensions();
        vec2 firstPixel = floor(uv * dimensions - 0.5);
        float anchorSceneDistance = decodeAtmosphereDistance(anchorMetadata.b);
        float anchorMediumDistance = decodeAtmosphereDistance(anchorMetadata.r);
        float sceneTolerance = max(120.0, anchorSceneDistance * 0.025);
        float mediumTolerance = max(120.0, anchorMediumDistance * 0.1);
        bool anchorOpenSky = atmospherePreviousDepthIsClear(anchorUv);
        for (int y = 0; y < 2; ++y)
            for (int x = 0; x < 2; ++x)
            {
                vec2 sampleUv = (clamp(firstPixel + vec2(float(x), float(y)),
                    vec2(0.0), dimensions - 1.0) + 0.5) / dimensions;
                vec4 sampleMetadata = omw_GetAtmosphereMetadataHistory(sampleUv);
                float sampleSceneDistance = decodeAtmosphereDistance(sampleMetadata.b);
                float sampleMediumDistance = decodeAtmosphereDistance(sampleMetadata.r);
                bool sampleOpenSky = atmospherePreviousDepthIsClear(sampleUv);
                if (sampleOpenSky != anchorOpenSky
                    || abs(sampleSceneDistance - anchorSceneDistance) > sceneTolerance
                    || (sampleMetadata.g > 1e-4
                        && (abs(sampleMediumDistance - anchorMediumDistance) > mediumTolerance
                            || (!sampleOpenSky && sampleMediumDistance > sampleSceneDistance + sceneTolerance))))
                    return omw_GetAtmosphereHistory(anchorUv);
            }
        return omw_GetAtmosphereHistory(uv);
    }

    /// Preserve current traced pixels and mark untraced disocclusions for the shared ray-repair pass.
    void writeFreshAtmosphere(vec4 current, vec4 metadata, bool tracedPixel)
    {
        if (!tracedPixel)
            metadata.a = -1.0;
        omw_FragColor = current;
        omw_FragColor1 = metadata;
    }

    /// Reuse checkerboard history only when scene visibility and volume correspondence remain valid.
    void main()
    {
        vec2 pixelCoordinate = floor(gl_FragCoord.xy);
        vec2 blockCoordinate = floor(pixelCoordinate * 0.5);
        vec2 rawDimensions = atmosphereRawDimensions();
        vec2 rawUv = (blockCoordinate + 0.5) / rawDimensions;
        vec4 currentVolume = omw_Texture2D(AtmosphereVolumeRaw, rawUv);
        vec4 currentMetadata = omw_Texture2D(AtmosphereVolumeMetadataRaw, rawUv);
        bool tracedPixel = all(equal(mod(pixelCoordinate, 2.0), atmosphereCheckerboardOffset(blockCoordinate)));
        if (any(greaterThanEqual(blockCoordinate, rawDimensions)))
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, false);
            return;
        }
        if (!atmosphereTemporalSamplingEnabled() || !omw.atmosphereEnabled)
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, tracedPixel);
            return;
        }

        // Motion beyond half the finest retained billow wavelength has no reliable history correspondence.
        if (length(omw.atmosphereCloudAdvectionDeltaWorldUnits)
            > maximumAtmosphereHistoryAdvectionWorldUnits)
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, tracedPixel);
            return;
        }

        vec3 worldPosition = omw_GetWorldPosFromUV(omw_TexCoord);
        bool currentOpenSky = atmosphereDepthIsClear(omw_TexCoord);
        vec3 rayDirection = normalize(worldPosition - omw.eyePos.xyz);
        float sceneDistance = atmosphereSceneRayDistance(omw_TexCoord);
        float rawSceneDistance = decodeAtmosphereDistance(currentMetadata.b);
        float mediumDistance = decodeAtmosphereDistance(currentMetadata.r);
        vec2 tracedCoordinate = blockCoordinate * 2.0 + atmosphereCheckerboardOffset(blockCoordinate);
        bool tracedOpenSky = atmosphereDepthIsClear((tracedCoordinate + 0.5) / atmosphereVolumeDimensions());
        float terminationWeight = atmosphereTerminationWeight(currentOpenSky, tracedOpenSky,
            mediumDistance, sceneDistance, rawSceneDistance, max(120.0, mediumDistance * 0.025),
            max(120.0, sceneDistance * 0.025));
        if (terminationWeight < 0.999)
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, false);
            return;
        }
        currentMetadata.b = encodeAtmosphereDistance(sceneDistance);

        // Deterministic cloud quadrature needs no stochastic accumulation on a traced ray.
        // Publish it immediately so changing view integrals cannot inherit multi-refresh edge lag.
        if (tracedPixel && currentMetadata.a >= 1.5)
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, true);
            return;
        }

        // Reproject geometry independently from participating media. Geometry depth validates disocclusion,
        // while the native fog/mist field retains its own advection. Cloud density contains
        // independent shape, coverage, and curl motion, so its source reprojection uses camera motion.
        vec3 scenePosition
            = omw.eyePos.xyz + rayDirection * decodeAtmosphereDistance(currentMetadata.b);
        vec4 previousSceneViewPosition = omw.prevViewMatrix * vec4(scenePosition, 1.0);
        vec4 previousSceneClipPosition = omw.prevProjectionMatrix * previousSceneViewPosition;
        vec2 previousSceneUv = previousSceneClipPosition.xy
            / max(previousSceneClipPosition.w, 0.0001) * 0.5 + 0.5;

        vec3 reprojectionPosition
            = omw.eyePos.xyz + rayDirection * decodeAtmosphereDistance(currentMetadata.r);
        reprojectionPosition.xy += omw.atmosphereCloudAdvectionDeltaWorldUnits
            * atmosphereMediumAdvectionScale(currentMetadata.a);

        vec4 previousViewPosition = omw.prevViewMatrix * vec4(reprojectionPosition, 1.0);
        vec4 previousClipPosition = omw.prevProjectionMatrix * previousViewPosition;
        vec2 previousUv = previousClipPosition.xy / max(previousClipPosition.w, 0.0001) * 0.5 + 0.5;
        bool mediumInsidePreviousFrame = previousClipPosition.w > 0.0
            && previousUv.x > 0.001 && previousUv.x < 0.999
            && previousUv.y > 0.001 && previousUv.y < 0.999;
        bool sceneInsidePreviousFrame = previousSceneClipPosition.w > 0.0
            && previousSceneUv.x > 0.001 && previousSceneUv.x < 0.999
            && previousSceneUv.y > 0.001 && previousSceneUv.y < 0.999;
        if (!mediumInsidePreviousFrame || (!currentOpenSky && !sceneInsidePreviousFrame))
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, tracedPixel);
            return;
        }

        // Opaque silhouettes require one categorical historical endpoint. Open sky retains filtered
        // reprojection, then the current traced neighborhood rejects unsupported cross-medium mixtures.
        vec2 historyUv = !currentOpenSky ? atmosphereHistoryTexelCenter(previousUv) : previousUv;
        float sampledPreviousDepth = omw_GetPreviousLinearDepth(historyUv);
        vec4 previousMetadata = omw_GetAtmosphereMetadataHistory(historyUv);
        float expectedPreviousMediumDepth = abs(previousViewPosition.z);
        float mediumOcclusionTolerance = max(120.0, expectedPreviousMediumDepth * 0.025);
        // A far-plane depth sample represents unoccluded sky, not geometry in front of a beyond-far cloud layer.
        bool previousMediumOpenSky = atmospherePreviousDepthIsClear(historyUv);
        if (!previousMediumOpenSky
            && sampledPreviousDepth + mediumOcclusionTolerance < expectedPreviousMediumDepth)
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, tracedPixel);
            return;
        }
        float sampledPreviousSceneDepth = omw_GetPreviousLinearDepth(previousSceneUv);
        float expectedPreviousSceneDepth = abs(previousSceneViewPosition.z);
        float sceneDepthTolerance = max(120.0, expectedPreviousSceneDepth * 0.025);
        if (!currentOpenSky
            && abs(sampledPreviousSceneDepth - expectedPreviousSceneDepth) > sceneDepthTolerance)
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, tracedPixel);
            return;
        }
        // The sampled history owns its scene termination just as a paired cloud-depth history does.
        // Reject an otherwise depth-valid sample when it was integrated to a different surface or clear sky;
        // relabeling that radiance with the current metadata projects stale clouds onto silhouettes and mist.
        float previousHistorySceneDistance = decodeAtmosphereDistance(previousMetadata.b);
        float historySceneTolerance = max(120.0, sceneDistance * 0.025);
        if (abs(previousHistorySceneDistance - sceneDistance) > historySceneTolerance)
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, tracedPixel);
            return;
        }
        float previousHistoryMediumDistance = decodeAtmosphereDistance(previousMetadata.r);
        if (!currentOpenSky
            && previousHistoryMediumDistance > sceneDistance + historySceneTolerance)
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, tracedPixel);
            return;
        }

        // A blended volume can change its representative depth as nearby mist reveals distant clouds.
        // Validate correspondence in pixels rather than treating that moment as an opaque surface: the
        // historical sample must project back inside the current pixel before its radiance can be reused.
        vec3 previousEye = -omw.prevViewMatrix[3].xyz * mat3(omw.prevViewMatrix);
        vec3 previousRay = normalize(reprojectionPosition - previousEye);
        vec3 previousMediumPosition = previousEye + previousRay * previousHistoryMediumDistance;
        previousMediumPosition.xy -= omw.atmosphereCloudAdvectionDeltaWorldUnits
            * atmosphereMediumAdvectionScale(previousMetadata.a);
        vec4 historyCurrentClip = omw.projectionMatrix * omw.viewMatrix * vec4(previousMediumPosition, 1.0);
        vec2 historyCurrentUv = historyCurrentClip.xy / max(historyCurrentClip.w, 0.0001) * 0.5 + 0.5;
        vec2 correspondenceError = abs(historyCurrentUv - omw_TexCoord) * atmosphereVolumeDimensions();
        if (historyCurrentClip.w <= 0.0 || max(correspondenceError.x, correspondenceError.y) > 0.5)
        {
            writeFreshAtmosphere(currentVolume, currentMetadata, tracedPixel);
            return;
        }

        // The volume moment locates history and scene geometry validates its visibility.
        // Cloud refreshes publish the deterministic integral; fog and mist retain statistical accumulation.
        bool containsCloud = max(currentMetadata.a, previousMetadata.a) >= 1.5;
        vec4 history = containsCloud && !currentOpenSky
            ? sampleTerrainCloudHistory(previousUv, historyUv, previousMetadata)
            : omw_GetAtmosphereHistory(historyUv);
        if (containsCloud && tracedPixel)
        {
            // A newly empty ray must also replace a previous cloud integral without fading its stale silhouette.
            writeFreshAtmosphere(currentVolume, currentMetadata, true);
            return;
        }
        if (!containsCloud)
            history = clipLocalMediaHistory(history, rawUv);
        if (!tracedPixel)
        {
            // Carry the previous radial moment into the current camera/advection frame. It is not an opaque depth.
            previousMetadata.r = encodeAtmosphereDistance(length(previousMediumPosition - omw.eyePos.xyz));
            previousMetadata.g = 1.0 - history.a;
            omw_FragColor = history;
            omw_FragColor1 = previousMetadata;
            return;
        }
        // Fog and mist use opacity confidence and quality to select their temporal response.
        float confidence = max(currentMetadata.g, previousMetadata.g);
        float confidenceWeight = mix(0.94, 1.0, smoothstep(0.0, 0.15, confidence));
        float qualityWeight = float(omw.atmosphereQuality) / 3.0;
        float volumeHistoryWeight = mix(0.82, 0.92, qualityWeight);
        float historyWeight
            = volumeHistoryWeight * confidenceWeight * omw.atmosphereHistoryLightingWeight;
        omw_FragColor = mix(currentVolume, history, pow(historyWeight, 4.0));
        currentMetadata.g = 1.0 - omw_FragColor.a;
        omw_FragColor1 = currentMetadata;
    }
}

vertex resolveAtmosphereVolumeHistory {
    #include "lib/atmosphere/volume_lighting_vertex.glsl"
}

fragment resolveAtmosphereVolumeHistory(
    target=AtmosphereVolumeHistory, secondary_target=AtmosphereVolumeMetadataHistory,
    rt1=AtmosphereVolumeReprojected, rt2=AtmosphereVolumeMetadataReprojected) {
    #pragma import_defines(OPENMWSE_CLOUD_STEADY)
    omw_In vec2 omw_TexCoord;
#if __VERSION__ >= 130 || defined(GL_EXT_gpu_shader4)
    flat
#endif
    omw_In vec3 atmosphereLowSolarIrradiance;
#if __VERSION__ >= 130 || defined(GL_EXT_gpu_shader4)
    flat
#endif
    omw_In vec3 atmosphereLowDiffuseRadiance;
#if __VERSION__ >= 130 || defined(GL_EXT_gpu_shader4)
    flat
#endif
    omw_In vec3 atmosphereBelowCloudDiffuse;


    /// Repair only unavailable rays and publish complete ordered radiance and metadata to history.
    void main()
    {
        vec4 metadata = omw_Texture2D(AtmosphereVolumeMetadataReprojected, omw_TexCoord);
        vec4 volume;
        if (metadata.a < 0.0)
            volume = integrateAtmosphereAtUv(
                (floor(gl_FragCoord.xy) + 0.5) / atmosphereVolumeDimensions(),
                OpenMWSEVolumeIllumination(atmosphereLowSolarIrradiance, atmosphereLowDiffuseRadiance),
                atmosphereBelowCloudDiffuse, metadata);
        else
            volume = omw_Texture2D(AtmosphereVolumeReprojected, omw_TexCoord);
        omw_FragColor = volume;
        omw_FragColor1 = metadata;
    }
}

fragment prepareShaftSource(target=AtmosphereShaftMask, rt1=AtmosphereVolumeHistory) {
    omw_In vec2 omw_TexCoord;

    /// Extend the reference depth source through native volumetric clouds without changing textured-sky behavior.
    float shaftSourceVisibility(vec2 uv)
    {
        if (!atmosphereDepthIsClear(uv))
            return 0.0;
        if (omw.atmosphereEnabled && omw.volumetricCloudsEnabled)
            return clamp(omw_Texture2D(AtmosphereVolumeHistory, uv).a, 0.0, 1.0);
        return 1.0;
    }

    /// Downsample the scene's clear-depth mask over the same four source pixels used by MGE XE.
    void main()
    {
        vec4 viewSun = omw.viewMatrix * vec4(normalize(omw.sunPos.xyz), 0.0);
        float visible = 0.0;
        if (omw.godraysEnabled && (omw.atmosphereEnabled || omw.sunlightEnabled) && viewSun.z < 0.0)
        {
            vec2 corner = omw_TexCoord - 0.5 * omw.rcpResolution;
            visible += 0.25 * shaftSourceVisibility(corner);
            visible += 0.25 * shaftSourceVisibility(corner + vec2(omw.rcpResolution.x, 0.0));
            visible += 0.25 * shaftSourceVisibility(corner + vec2(0.0, omw.rcpResolution.y));
            visible += 0.25 * shaftSourceVisibility(corner + omw.rcpResolution);
        }
        omw_FragColor = vec4(0.0, 0.0, 0.0, visible);
    }
}

fragment filterShaftSource(target=AtmosphereShaftSource, rt1=AtmosphereShaftMask) {
    omw_In vec2 omw_TexCoord;

    /// Apply MGE's radial five-tap source filter in full-frame UV coordinates.
    void main()
    {
        vec2 offset = omw_TexCoord - projectedSun();
        vec2 radial = offset / max(length(offset), 0.000001) * 2.0 * omw.rcpResolution.yx;
        float visibility = omw_Texture2D(AtmosphereShaftMask, omw_TexCoord).a * 0.3333;
        visibility += (omw_Texture2D(AtmosphereShaftMask, omw_TexCoord + radial).a
            + omw_Texture2D(AtmosphereShaftMask, omw_TexCoord - radial).a) * 0.2222;
        visibility += (omw_Texture2D(AtmosphereShaftMask, omw_TexCoord + 2.0 * radial).a
            + omw_Texture2D(AtmosphereShaftMask, omw_TexCoord - 2.0 * radial).a) * 0.1111;
        omw_FragColor = vec4(0.0, 0.0, 0.0, visibility);
    }
}

fragment integrateShafts(target=AtmosphereShaftRays, rt1=AtmosphereShaftSource) {
    omw_In vec2 omw_TexCoord;

    /// Reconstruct MGE XE's finite solar emitter, radial falloff, off-screen fade, and unassociated ray color.
    void main()
    {
        vec4 viewSun = omw.viewMatrix * vec4(normalize(omw.sunPos.xyz), 0.0);
        if (!omw.godraysEnabled || !(omw.atmosphereEnabled || omw.sunlightEnabled) || viewSun.z >= 0.0)
        {
            omw_FragColor = vec4(0.0);
            return;
        }
        vec2 sunUv = projectedSun();
        vec2 screenMargin = vec2(0.5) - abs(sunUv - vec2(0.5));
        vec2 edgeVisibility = smoothstep(vec2(-0.5), vec2(0.0), screenMargin);
        // MGE's engine lifts post-process sun visibility in fair weather before running Sunshafts.fx.
        float visibility = mix(clamp(omw.sunVis, 0.0, 1.0), 1.0,
            0.333 * clamp(omw.atmosphereWeatherWeight, 0.0, 1.0));
        float strength = 1.7 * visibility * (2.0 - visibility) * edgeVisibility.x * edgeVisibility.y
            * max(omw.atmosphereMistParameters.w, 0.0);
        if (strength <= 0.000001)
        {
            omw_FragColor = vec4(0.0);
            return;
        }
        vec2 offset = omw_TexCoord - sunUv;
        float distance = length(offset * vec2(1.0, omw.resolution.y / omw.resolution.x));
        vec2 direction = offset / max(distance, 0.000001);
        float emitterRadius = min(0.25, distance);
        float illumination = 0.0;
        for (int sampleIndex = 1; sampleIndex <= 20; ++sampleIndex)
        {
            float radius = emitterRadius * (float(sampleIndex) / 20.0);
            vec2 sourceUv = clamp(sunUv + direction * radius, vec2(0.0), vec2(1.0));
            float sourceVisibility = omw_Texture2D(AtmosphereShaftSource, sourceUv).a;
            float attenuation = exp(-1.10 * (distance - radius) / (0.125 + radius));
            float emitterFalloff = pow(max(1.0 - radius / 0.25, 0.0), 1.5);
            illumination += sourceVisibility * attenuation * emitterFalloff;
        }
        float opacity = illumination * (strength / 20.0) * (0.3 + 0.7 * distance / 0.25);
        vec3 color = omw.sunColor.rgb * vec3(1.0, 0.8, 0.8) * (1.0 + 1.25 * opacity * opacity * opacity);
        omw_FragColor = vec4(color, opacity);
    }
}

fragment filterShaftRays(target=AtmosphereShafts, rt1=AtmosphereShaftRays) {
    omw_In vec2 omw_TexCoord;

    /// Smooth ray edges tangentially with MGE's full-resolution five-tap filter.
    void main()
    {
        vec2 offset = omw_TexCoord - projectedSun();
        vec2 tangent = offset.yx / max(length(offset), 0.000001) * vec2(omw.rcpResolution.y, -omw.rcpResolution.x);
        vec4 rays = omw_Texture2D(AtmosphereShaftRays, omw_TexCoord) * 0.3333;
        rays += (omw_Texture2D(AtmosphereShaftRays, omw_TexCoord + tangent)
            + omw_Texture2D(AtmosphereShaftRays, omw_TexCoord - tangent)) * 0.2222;
        rays += (omw_Texture2D(AtmosphereShaftRays, omw_TexCoord + 2.0 * tangent)
            + omw_Texture2D(AtmosphereShaftRays, omw_TexCoord - 2.0 * tangent)) * 0.1111;
        omw_FragColor = rays;
    }
}

fragment composite(rt1=AtmosphereVolumeHistory, rt2=AtmosphereShafts, rt3=AtmosphereVolumeMetadataHistory) {
    omw_In vec2 omw_TexCoord;

    /// Compose scene-linear media and independent solar effects while preserving full-resolution geometry and alpha.
    void main()
    {
        vec4 baseColor = omw_GetLastShader(omw_TexCoord);
        float centerSceneDistance = atmosphereSceneRayDistance(omw_TexCoord);
        bool centerOpenSky = atmosphereDepthIsClear(omw_TexCoord);
        vec2 lowResolution = atmosphereVolumeDimensions();
        vec2 lowResolutionTexel = 1.0 / max(lowResolution, vec2(1.0));
        vec2 lowResolutionPosition = omw_TexCoord * lowResolution - 0.5;
        vec2 lowResolutionBase = floor(lowResolutionPosition);
        vec2 lowResolutionFraction = fract(lowResolutionPosition);
        vec4 volume = vec4(0.0);
        float weightSum = 0.0;
        for (int sampleIndex = 0; sampleIndex < 4; ++sampleIndex)
        {
            float index = float(sampleIndex);
            vec2 corner = vec2(mod(index, 2.0), floor(index * 0.5));
            vec2 sampleUv = (lowResolutionBase + corner + 0.5) * lowResolutionTexel;
            sampleUv = clamp(sampleUv, lowResolutionTexel * 0.5, vec2(1.0) - lowResolutionTexel * 0.5);
            vec2 axisWeight = mix(vec2(1.0) - lowResolutionFraction, lowResolutionFraction, corner);
            float spatialWeight = axisWeight.x * axisWeight.y;
            vec4 metadata = omw_Texture2D(AtmosphereVolumeMetadataHistory, sampleUv);
            float representativeDistance = decodeAtmosphereDistance(metadata.r);
            float sampleSceneDistance = decodeAtmosphereDistance(metadata.b);
            float depthTolerance = max(80.0, centerSceneDistance * 0.012);
            float terminationTolerance = max(80.0, centerSceneDistance * 0.015);
            bool sampleOpenSky = atmosphereDepthIsClear(sampleUv);
            float occlusionDistance
                = centerOpenSky ? 0.0 : max(representativeDistance - centerSceneDistance, 0.0);
            float terminationWeight = atmosphereTerminationWeight(centerOpenSky, sampleOpenSky,
                representativeDistance, centerSceneDistance, sampleSceneDistance, depthTolerance,
                terminationTolerance);
            float depthWeight = spatialWeight
                * (1.0 - smoothstep(0.0, depthTolerance, occlusionDistance)) * terminationWeight;
            depthWeight *= mix(0.25, 1.0, smoothstep(0.0, 0.08, metadata.g));
            volume += omw_Texture2D(AtmosphereVolumeHistory, sampleUv) * depthWeight;
            weightSum += depthWeight;
        }
        if (weightSum > 0.05)
            volume /= weightSum;
        else
            volume = vec4(0.0, 0.0, 0.0, 1.0);

        bool finiteVolume = volume.a >= 0.0 && volume.a <= 1.0
            && all(greaterThanEqual(volume.rgb, vec3(0.0)))
            && all(lessThanEqual(volume.rgb, vec3(65504.0)));
        bool missingVolume = dot(abs(volume), vec4(1.0)) <= 0.000001;
        if (!finiteVolume || missingVolume)
            volume = vec4(0.0, 0.0, 0.0, 1.0);

        vec3 composedColor = baseColor.rgb * volume.a + volume.rgb;
        vec4 shafts = omw_Texture2D(AtmosphereShafts, omw_TexCoord);
        if (omw.godraysEnabled && shafts.a > 0.000001)
            composedColor = clamp(composedColor * clamp(1.0 - 0.75 * shafts.a, 0.0, 1.0)
                + shafts.rgb * shafts.a, vec3(0.0), vec3(1.0));
        if (centerOpenSky && omw.sunlightEnabled)
        {
            vec3 direction = sunlightWorldDirection(omw_TexCoord);
            float texturedTransmission = openmwseTexturedCloudViewTransmittance(direction);
            float solarTransmission = omw.cloudSunOcclusion ? volume.a * texturedTransmission : 1.0;
            composedColor += openmwseSolarDisc(direction, omw.sunPos.xyz, omw.atmosphereSunDiscColor)
                * solarTransmission;
            if (omw.cloudSunOcclusion && openmwseTexturedCloudsEnabled)
                composedColor += openmwseTexturedCloudBloom(direction,
                    normalize(omw.sunPos.xyz), omw.atmosphereSunDiscColor) * volume.a;
            if (omw.sunGlareEnabled)
            {
                vec2 sunUv = projectedSun();
                vec4 viewSun = omw.viewMatrix * vec4(normalize(omw.sunPos.xyz), 0.0);
                vec2 angularOffset = (omw_TexCoord - sunUv) * vec2(omw.resolution.x / omw.resolution.y, 1.0);
                vec2 glareUv = angularOffset / 0.22 + 0.5;
                if (viewSun.z < 0.0 && all(greaterThanEqual(glareUv, vec2(0.0)))
                    && all(lessThanEqual(glareUv, vec2(1.0))))
                {
                    float sourceVisibility = 0.0;
                    for (int sampleIndex = 0; sampleIndex < 9; ++sampleIndex)
                    {
                        float angle = float(sampleIndex - 1) * 0.785398163;
                        vec2 offset = sampleIndex == 0 ? vec2(0.0) : vec2(cos(angle), sin(angle));
                        mat4 projection = omw_ProjectionMatrix();
                        vec2 sourceUv = sunUv + offset * vec2(projection[0][0], projection[1][1]) * 0.012;
                        if (all(greaterThanEqual(sourceUv, vec2(0.0))) && all(lessThanEqual(sourceUv, vec2(1.0)))
                            && atmosphereDepthIsClear(sourceUv))
                            sourceVisibility += omw_Texture2D(AtmosphereVolumeHistory, sourceUv).a
                                * openmwseTexturedCloudViewTransmittance(sunlightWorldDirection(sourceUv));
                    }
                    vec4 glare = texture2D(openmwseSunGlareTexture, glareUv);
                    composedColor += glare.rgb * glare.a * omw.atmosphereSunDiscColor.rgb
                        * omw.atmosphereSunDiscColor.a * (sourceVisibility / 9.0)
                        * texturedTransmission * volume.a;
                }
            }
        }
        omw_FragColor = vec4(composedColor, baseColor.a);
    }
}

technique {
    passes = integrateAtmosphereVolume, reprojectAtmosphereVolume, resolveAtmosphereVolumeHistory,
        prepareShaftSource, filterShaftSource, integrateShafts, filterShaftRays, composite;
    description = "Native OpenMWSE atmospheric clouds, mist, and sun shafts";
    version = "1.0";
    author = "OpenMWSE contributors";
    flags = disable_interiors, disable_underwater, hidden;
    glsl_extensions = GL_EXT_gpu_shader4;
    pass_lights = true;
}
